{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post-call.schema.json",
  "title": "Post-call extraction",
  "description": "Extracted from every call transcript by our own Haiku step (provider-agnostic). Drives the lead timeline, next steps and pathway tuning.",
  "type": "object",
  "required": ["call_id", "flow", "outcome", "reached_owner", "stop_requested"],
  "additionalProperties": false,
  "properties": {
    "call_id": { "type": "string" },
    "lead_id": { "type": "string" },
    "flow": { "enum": ["first_call", "follow_up", "walkthrough_close", "inbound_line", "onboarding_verification", "client_checkin"] },
    "outcome": {
      "enum": [
        "checkout_link_sent", "meeting_booked", "visual_sent", "callback_scheduled", "access_granted",
        "verification_pending", "ticket_created", "not_interested", "stop",
        "gatekeeper", "voicemail", "no_answer", "transferred_to_human", "other"
      ]
    },
    "reached_owner": { "type": "boolean" },
    "talk_seconds": { "type": "integer", "minimum": 0 },
    "interest_level": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 none, 1 curious, 2 warm, 3 ready to buy" },
    "objections": {
      "type": "array",
      "items": { "enum": ["price", "is_this_google", "spam_fatigue", "has_agency", "diy", "timing", "no_value_seen", "wants_guarantee", "other"] }
    },
    "who_manages_profile": { "enum": ["owner", "staff", "agency", "nobody", "unknown"] },
    "questions_asked": { "type": "array", "items": { "type": "string" } },
    "profile_changes_requested": { "type": "array", "items": { "type": "string" }, "description": "Hours, services, events etc. (client check-ins and inbound support)" },
    "csat": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "callback_at": { "type": ["string", "null"], "format": "date-time" },
    "best_time_to_call": { "type": ["string", "null"] },
    "follow_up": { "type": "string", "description": "One sentence: the next action for the pipeline or the founder" },
    "stop_requested": { "type": "boolean" },
    "agent_issues": {
      "type": "array",
      "items": { "enum": ["talked_over_caller", "wrong_fact", "off_script_price", "latency_complaint", "mispronounced_name", "other"] },
      "description": "Anything to fix in the pathway. Non-empty => founder review."
    }
  }
}
